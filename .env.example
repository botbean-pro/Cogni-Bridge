VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Server-side only. Do not prefix these with VITE_.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_openrouter_model_id
# Optional: an image-capable model for handwriting analysis (defaults to google/gemini-3.8-flash).
OPENROUTER_VISION_MODEL=
APP_URL=http://localhost:5173
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional: a voice ID from your own ElevenLabs voices (free plans cannot use Voice Library voices via the API).
ELEVENLABS_VOICE_ID=
