VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Server-side only. Do not prefix these with VITE_.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_openrouter_model_id
# Optional: an image-capable model for handwriting analysis. Leave blank to keep the key on OPENROUTER_MODEL only
# (handwriting then uses the on-device check).
OPENROUTER_VISION_MODEL=
# Optional: lets mentors click "Create Meet link". OAuth client from Google Cloud (Google Auth Platform > Clients)
# and a refresh token for the Google account that owns the meetings (scope meetings.space.created).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
APP_URL=http://localhost:5173
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional: a voice ID from your own ElevenLabs voices (free plans cannot use Voice Library voices via the API).
ELEVENLABS_VOICE_ID=
